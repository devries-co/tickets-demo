{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tickets-demo",
	"main": "./src/worker/index.ts",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"workers_dev": true,
	"routes": [
		{
			"pattern": "labs.mygriefguide.org",
			"custom_domain": true
		}
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "ripple"
		},
		{
			"binding": "NF_DB",
			"database_name": "never-forgotten"
		},
		{
			"binding": "UC_DB",
			"database_name": "unfinished-conversations"
		},
		{
			"binding": "LABS_DB",
			"database_name": "labs"
		}
	],
	"triggers": {
		"crons": [
			"0 14 * * *",
			"0 * * * *"
		]
	},
	"assets": {
		"directory": "./dist/client",
		"not_found_handling": "single-page-application",
		"binding": "ASSETS",
		"run_worker_first": [
			"/",
			"/labs",
			"/api/*",
			"/never-forgotten/remember/*"
		]
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "PORCHLIGHT",
				"class_name": "PorchlightStore"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"PorchlightStore"
			]
		}
	]
}
